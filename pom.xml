<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.acme</groupId>
    <artifactId>wildfly-galleon-test</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <wildfly-maven-plugin.version>6.0.2.Final-SNAPSHOT</wildfly-maven-plugin.version>
        <jboss-maven-dist>false</jboss-maven-dist>
        <jboss-cyclonedx>true</jboss-cyclonedx>
        <jboss-cyclonedx-only>false</jboss-cyclonedx-only>
        <jboss-cyclonedx-licenses>false</jboss-cyclonedx-licenses>
        <jboss-cyclonedx-output/>
    </properties>

    <build>
        <defaultGoal>clean wildfly:provision</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>${wildfly-maven-plugin.version}</version>
                <configuration>
                    <channels>
                        <channel>
                            <manifest>
                                <groupId>org.jboss.eap.channels</groupId>
                                <artifactId>eap-8.1</artifactId>
                            </manifest>
                        </channel>
                        <!--
                            Layered override channel: forces the locally-built wildfly-galleon-plugins
                            snapshot (with SBOM support) over the eap-8.1-pinned 7.3.2.Final-redhat.
                            Channel resolution takes the highest version across channels, so this wins
                            for this GA only; everything else stays governed by eap-8.1 (EAP Update 6.0).
                        -->
                        <channel>
                            <manifest>
                                <url>file:galleon-plugins-override-manifest.yaml</url>
                            </manifest>
                        </channel>
                    </channels>
                    <feature-packs>
                        <feature-pack>
                            <groupId>org.jboss.eap</groupId>
                            <artifactId>wildfly-ee-galleon-pack</artifactId>
                        </feature-pack>
                        <feature-pack>
                            <groupId>org.jboss.eap</groupId>
                            <artifactId>eap-datasources-galleon-pack</artifactId>
                        </feature-pack>
                        <feature-pack>
                            <groupId>org.jboss.eap.cloud</groupId>
                            <artifactId>eap-cloud-galleon-pack</artifactId>
                        </feature-pack>
                        <feature-pack>
                            <groupId>org.keycloak</groupId>
                            <artifactId>keycloak-saml-adapter-galleon-pack</artifactId>
                        </feature-pack>
                        <feature-pack>
                            <groupId>org.jboss.eap</groupId>
                            <artifactId>eap-myfaces-feature-pack</artifactId>
                        </feature-pack>
                        <feature-pack>
                            <groupId>org.wildfly.prospero</groupId>
                            <artifactId>prospero-wildfly-galleon-pack</artifactId>
                        </feature-pack>
                    </feature-packs>
                    <galleonOptions>
                        <jboss-cyclonedx>${jboss-cyclonedx}</jboss-cyclonedx>
                        <jboss-maven-dist>${jboss-maven-dist}</jboss-maven-dist>
                        <jboss-cyclonedx-only>${jboss-cyclonedx-only}</jboss-cyclonedx-only>
                        <jboss-cyclonedx-licenses>${jboss-cyclonedx-licenses}</jboss-cyclonedx-licenses>
                        <jboss-cyclonedx-output>${jboss-cyclonedx-output}</jboss-cyclonedx-output>
                        <jboss-cyclonedx-pretty-print>false</jboss-cyclonedx-pretty-print>
                    </galleonOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>install-wildfly</id>
                        <goals>
                            <goal>provision</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

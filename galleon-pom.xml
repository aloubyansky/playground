<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.acme</groupId>
    <artifactId>wildfly-galleon-test</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <wildfly.version>40.0.0.Final</wildfly.version>
        <galleon-maven-plugin.version>7.0.11.Final-SNAPSHOT</galleon-maven-plugin.version>
        <jboss-maven-dist>false</jboss-maven-dist>
        <jboss-cyclonedx>true</jboss-cyclonedx>
        <jboss-cyclonedx-only>false</jboss-cyclonedx-only>
        <jboss-cyclonedx-licenses>false</jboss-cyclonedx-licenses>
        <jboss-cyclonedx-pretty-print>true</jboss-cyclonedx-pretty-print>
        <jboss-cyclonedx-output/>
        <!--
            Cosmetic-only: override the product-conf artifact to the EAP 8.1 Update 6.0 GA so the
            provisioned server's version.txt and runtime banner report "Update 6.0", matching the
            channel-driven EAP plugin build. NOTE: this only relabels the product info; all other
            library artifacts remain at the feature-pack-pinned 8.1.1 (Update 1.0) versions. For a
            genuine, fully-upgraded Update 6.0 build, provision through the eap-8.1 channel (e.g. via
            org.wildfly.plugins:wildfly-maven-plugin, which supports <channels>).
            Two coordinates are overridden: the plain jar (product module manifest -> runtime banner)
            and the version:txt variant (copy-artifact task -> dist-root version.txt).
        -->
        <jboss-overridden-artifacts>org.jboss.eap:wildfly-ee-feature-pack-product-conf:801.6.0.GA-redhat-00001::jar|org.jboss.eap:wildfly-ee-feature-pack-product-conf:801.6.0.GA-redhat-00001:version:txt</jboss-overridden-artifacts>
    </properties>

    <repositories>
        <repository>
            <id>jboss-public-repository-group</id>
            <name>JBoss Public Repository Group</name>
            <url>https://repository.jboss.org/nexus/content/groups/public/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>jboss-public-repository-group</id>
            <name>JBoss Public Repository Group</name>
            <url>https://repository.jboss.org/nexus/content/groups/public/</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <defaultGoal>clean galleon:provision</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.jboss.galleon</groupId>
                <artifactId>galleon-maven-plugin</artifactId>
                <version>${galleon-maven-plugin.version}</version>
                <configuration>
                    <install-dir>${project.build.directory}/wildfly</install-dir>
                    <feature-packs>
                        <!--
                        <feature-pack>
                            <groupId>org.wildfly</groupId>
                            <artifactId>wildfly-galleon-pack</artifactId>
                            <version>${wildfly.version}</version>
                        </feature-pack>
                        -->
                        <feature-pack>
                            <groupId>org.jboss.eap</groupId>
                            <artifactId>wildfly-ee-galleon-pack</artifactId>
                            <version>8.1.1.GA-redhat-00017</version>
                        </feature-pack>
                    </feature-packs>
                    <plugin-versions>
                        <plugin-version>org.wildfly.galleon-plugins:wildfly-galleon-plugins:jar:8.2.0.Final-SNAPSHOT</plugin-version>
                    </plugin-versions>
                    <plugin-options>
                        <jboss-cyclonedx>${jboss-cyclonedx}</jboss-cyclonedx>
                        <jboss-maven-dist>${jboss-maven-dist}</jboss-maven-dist>
                        <jboss-cyclonedx-only>${jboss-cyclonedx-only}</jboss-cyclonedx-only>
                        <jboss-cyclonedx-licenses>${jboss-cyclonedx-licenses}</jboss-cyclonedx-licenses>
                        <jboss-cyclonedx-output>${jboss-cyclonedx-output}</jboss-cyclonedx-output>
                        <jboss-cyclonedx-pretty-print>${jboss-cyclonedx-pretty-print}</jboss-cyclonedx-pretty-print>
                        <jboss-overridden-artifacts>${jboss-overridden-artifacts}</jboss-overridden-artifacts>
                    </plugin-options>
                </configuration>
                <executions>
                    <execution>
                        <id>install-wildfly</id>
                        <goals>
                            <goal>provision</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
